# The API binds CORS only to explicitly listed origins. Empty means disabled.
TRACEX_ENV=development
TRACEX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL credentials are supplied through this environment variable.
# Replace CHANGE_ME locally; never commit a populated value.
TRACEX_DATABASE_URL=postgresql+psycopg://tracex_user:CHANGE_ME@localhost:5432/tracex_greengrid
TRACEX_DATA_DIR=./data

# Opaque bearer tokens mapped to stable principal IDs. Use random tokens of at least
# 32 characters in production. Every private run, analysis, incident, and download
# endpoint is scoped to this principal. Keep this JSON secret in the deployment env.
TRACEX_API_TOKENS={}

# Optional separately deployed AI service. Unset means jobs are recorded as failed
# with provider_unavailable; no predictions are fabricated.
TRACEX_AI_SERVICE_URL=
TRACEX_AI_SERVICE_API_KEY=
TRACEX_AI_TIMEOUT_SECONDS=10
TRACEX_AI_MAX_RETRIES=1
TRACEX_AI_WORKERS=2
TRACEX_AI_QUEUE_SIZE=8
