# Leave empty to use the Vite proxy at http://127.0.0.1:8000.
# Set this to the FastAPI origin when the API is hosted elsewhere.
VITE_API_BASE_URL=

# Optional backend configuration. Defaults use the repository's outputs/ paths.
ORIGIN_DATABASE=outputs/server/greengrid.sqlite3
ORIGIN_ANOMALY_MODEL=outputs/stage2/anomaly.joblib
ORIGIN_SOURCE_MODEL=outputs/stage3/source_classifier.joblib
